    escreva("digite a sua idade:")
    leia(idade)

    escreva("digite a sua altura:")
    leia(altura)

    escreva("o seu nome e: ", nome)
    escreva(" a sua idade e: ", idade)
    escreva(" a sua altura e: ", altura)

    //
  }
}
