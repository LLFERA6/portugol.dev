// primeiro programa no portugol//
programa {
  funcao inicio() {
      inteiro num1, num2, soma
      // declarei  3 variaveis inteiras

      escreva("digite o primeiro numero")
      leia(num1)
      // o usuario vai 

      escreva("digite o segundo numero")
      leia(num2)

       soma = num1 + num2
       escreva("soma :", num1 + num2)
       

  }   
}
