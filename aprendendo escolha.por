programa {
  funcao inicio() {
    inteiro conceito

    escreva("informe um numero de 1 a 6: ")
    leia(conceito)

    escolha(conceito){
      caso 1:
      escreva("conceito: A")
      pare

      caso 2:
      escreva("conceito: B")
      pare

      caso 3:
      escreva("conceito: C")
      pare

      caso 4:
      escreva("conceito: D")
      pare

      caso 5:
      escreva("conceito: E")
      pare

      caso 6:
      escreva("conceito: F")
      pare


    }

  }
}
